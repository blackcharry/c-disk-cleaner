{
  "$schema": "https://raw.githubusercontent.com/nicbarker/tauri/next/packages/tauri-config-schema/schema.json",
  "productName": "C盘文件管家",
  "version": "0.1.0",
  "identifier": "com.blackcharry.cdiskcleaner",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "C盘文件管家",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
